# =========================
# HRMIS API - PRODUCTION ENV
# =========================
NODE_ENV=production
PORT=3000

# MongoDB Atlas. Use the hrmis database in the URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hrmis?retryWrites=true&w=majority

# Generate a strong random secret, e.g. openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Comma-separated frontend origins. Do not include a trailing slash.
CORS_ORIGIN=https://hrmis.example.gov.pk

# Persistent directory for approver attachments.
LEAVE_UPLOAD_DIR=/app/data/leave-actions

# =========================
# SEEDED LOGIN ACCOUNTS
# Change every password before production seeding.
# Passwords are hashed before storage in MongoDB.
# =========================
TEST_DOCTOR_EMAIL=doctor@hrmis.local
TEST_DOCTOR_PASSWORD=Doctor@12345
TEST_DOCTOR_PERSONNEL_NO=DOC-001
TEST_DOCTOR_BPS=17

