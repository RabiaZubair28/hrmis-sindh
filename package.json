{
  "name": "sindh-hrmis",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev -w @hrmis/api\" \"npm run dev -w @hrmis/web\"",
    "build": "npm run build -w @hrmis/api && npm run build -w @hrmis/web",
    "start:prod": "npm run start:prod -w @hrmis/api"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": "20.x"
  }
}
